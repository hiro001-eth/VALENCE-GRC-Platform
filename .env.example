# ============================================================
# VALENCE GRC DASHBOARD ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace placeholder values.
# ============================================================

# --- SIEM Integration ---
# SIEM_TYPE: Valid options are Splunk, Elastic, QRadar
SIEM_TYPE=Elastic
SIEM_BASE_URL=https://siem.internal:9200
SIEM_API_KEY=YOUR_SECRET_API_KEY_HERE
SIEM_DATA_TTL_MINUTES=30
SIEM_MAX_RESULTS_PER_PAGE=10000
SIEM_QUERY_TIMEOUT_SECONDS=300

# --- Metrics Configuration ---
METRIC_CONFIG_PATH=./rules/metric_definitions.yaml
METRIC_THRESHOLD_CONFIG_PATH=./rules/threshold_config.yaml
METRIC_FPR_FORMULA_PATH=./rules/fpr_formula.yaml
METRIC_TREND_PERIOD_DAYS=7

# --- MITRE ATT&CK Configuration ---
MITRE_STIX_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json
MITRE_CACHE_TTL_HOURS=168
MITRE_DETECTION_MAPPING_PATH=./rules/detection_mapping.yaml

# --- Dashboard & Rendering ---
DASHBOARD_TITLE="Security Metrics Dashboard"
DASHBOARD_REFRESH_INTERVAL_SECONDS=300
DASHBOARD_PDF_OUTPUT_DIR=./output

# --- Pipeline Execution ---
PIPELINE_OUTPUT_DIR=./output
PIPELINE_LOG_LEVEL=INFO
PIPELINE_RUN_ID_PREFIX=VALENCE

# --- Authentication / SSO (optional) ---
# Enable OIDC SSO and choose provider: azure | okta | oidc
AUTH_SSO_ENABLED=false
AUTH_SSO_PROVIDER=azure

# --- Microsoft Entra ID (Azure AD) ---
# Find tenant ID: Entra admin center → Overview → Tenant ID
AUTH_AZURE_TENANT_ID=
# App registration → Application (client) ID + client secret
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# Must match redirect URI registered in Entra (use https://your-domain/api/auth/sso/callback)
AUTH_OIDC_REDIRECT_URI=https://localhost/api/auth/sso/callback
# Optional: map Entra groups to VALENCE roles
# AUTH_SSO_GROUP_ROLE_MAP=Valence-Admins:admin,Valence-Auditors:auditor

# --- Okta (set AUTH_SSO_PROVIDER=okta) ---
# AUTH_OKTA_DOMAIN=your-org.okta.com
# AUTH_OKTA_AUTH_SERVER=default

# --- Generic OIDC (set AUTH_SSO_PROVIDER=oidc) ---
# AUTH_OIDC_ISSUER_URL=https://your-idp.example.com/oauth2/default

# --- SSO team provisioning ---
# Users must be invited via Team Access before SSO login (recommended).
# AUTH_SSO_AUTO_PROVISION=false
# AUTH_SSO_DEFAULT_TENANT=your-org-slug
JWT_SECRET_KEY=valence-grc-enterprise-secret-CHANGE-IN-PRODUCTION-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (production) ---
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/valence_grc
# REDIS_URL=redis://redis:6379/0

# --- Environment / sandbox credentials ---
# development | production | test
VALENCE_ENV=development
# Seed demo sandbox users on startup (false in production unless running pilots)
# VALENCE_SEED_DEMO_USERS=true
# Hide login-page password hints in production (enforced when VALENCE_ENV=production)
# VALENCE_SHOW_DEMO_CREDENTIALS=false
# Unified rotated password for all sandbox roles (production pilots)
# VALENCE_DEMO_PASSWORD=
# Or auto-generated file (chmod 600, gitignored):
# VALENCE_DEMO_CREDENTIALS_FILE=data/demo_credentials.json
# Attest external pen test completion (warning only until set)
# VALENCE_PEN_TEST_ATTESTED=false

# Production template: copy .env.production.example → .env then run ./scripts/validate_production.sh

# --- Login security ---
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SEC=60
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_SEC=900

# --- Security headers ---
# VALENCE_FORCE_HSTS=true

# --- SMTP (alerts + scheduled auditor report delivery) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@yourcompany.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=valence@yourcompany.com
ALERT_TO_EMAIL=ciso@yourcompany.com

# --- ChatOps (Slack slash command + Teams webhook) ---
# Slack app → Slash Commands → Request URL: https://your-domain/api/chatops/slack/command
# SLACK_SIGNING_SECRET=your_slack_signing_secret
# CHATOPS_DEFAULT_TENANT_ID=demo-global-hq
# CHATOPS_SLACK_TEAM_MAP={"T01234567":"demo-global-hq"}
# CHATOPS_TEAMS_WEBHOOK_SECRET=generate_random_secret
# CHATOPS_WEBHOOK_DEV_MODE=true

# --- OAuth marketplace integrations (live connectors) ---
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# OKTA_OAUTH_CLIENT_ID=
# OKTA_OAUTH_CLIENT_SECRET=
# OKTA_ORG_URL=https://your-org.okta.com
# AZURE_OAUTH_CLIENT_ID=
# AZURE_OAUTH_CLIENT_SECRET=
# VALENCE_ALLOW_DEMO_OAUTH=false

# --- AWS cross-account IAM role (preferred over OAuth for AWS) ---
# Connect via POST /api/integrations/oauth/aws/role with role_arn + external_id

# --- Stripe billing (production) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_ENTERPRISE=

# --- SCIM enterprise provisioning ---
# SCIM_BEARER_TOKEN=generate-long-random-token
# SCIM_DEFAULT_TENANT_ID=your-org-slug

# --- Edge rate limiting ---
# VALENCE_API_RATE_LIMIT=120
# VALENCE_API_RATE_WINDOW_SEC=60
# VALENCE_EDGE_RATE_LIMIT=true
# VALENCE_COLLECTOR_DEMO=false

# --- Database migrations (Postgres uses Alembic automatically) ---
# VALENCE_USE_ALEMBIC=true

# --- AI root-cause explainer (optional LLM upgrade) ---
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=
