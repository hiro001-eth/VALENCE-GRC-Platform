# ============================================================
# VALENCE GRC — PRODUCTION ENVIRONMENT
# Copy to .env and replace every CHANGE_ME / example.com value.
# Validate before launch: ./scripts/validate_production.sh
# ============================================================

VALENCE_ENV=production
VALENCE_RELOAD=false

# --- Security (required) ---
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
VALENCE_SHOW_DEMO_CREDENTIALS=false
VALENCE_SEED_DEMO_USERS=false
VALENCE_FORCE_HSTS=true
CORS_ALLOWED_ORIGINS=https://grc.yourcompany.com

# --- Data stores (required for HA) ---
POSTGRES_USER=valence_admin
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=valence_grc
DATABASE_URL=postgresql+asyncpg://valence_admin:CHANGE_ME_DB_PASSWORD@db:5432/valence_grc
REDIS_URL=redis://redis:6379/0

# --- TLS / public URL (nginx + SSO redirect) ---
VALENCE_PUBLIC_URL=https://grc.yourcompany.com

# --- SSO (recommended) ---
AUTH_SSO_ENABLED=false
AUTH_SSO_PROVIDER=azure
AUTH_AZURE_TENANT_ID=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=https://grc.yourcompany.com/api/auth/sso/callback

# --- Email (required for scheduled auditor/CISO reports) ---
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USER=notifications@yourcompany.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=valence@yourcompany.com
ALERT_TO_EMAIL=ciso@yourcompany.com

# --- SIEM (per-tenant; org admins configure in UI) ---
SIEM_TYPE=Elastic
SIEM_DEMO_MODE=false

# --- Login security ---
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SEC=60
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_SEC=900

# --- ChatOps bridges ---
# SLACK_SIGNING_SECRET=from_slack_app_basic_information
# CHATOPS_DEFAULT_TENANT_ID=your-tenant-slug
# CHATOPS_SLACK_TEAM_MAP={"T01234567":"your-tenant-slug"}
# CHATOPS_TEAMS_WEBHOOK_SECRET=generate_with_openssl_rand_hex_24
# CHATOPS_WEBHOOK_DEV_MODE=false

# --- Compliance attestation (set after external pen test) ---
VALENCE_PEN_TEST_ATTESTED=false
