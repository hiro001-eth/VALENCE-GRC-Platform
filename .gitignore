# =============================================================================
# VALENCE GRC — .gitignore
# Enforced by ADR-0008 (docs/adr/0008-repository-publication-boundaries.md)
# =============================================================================

# --- Secrets & environment ---
.env
.env.local
.env.production
.env.*.local
!.env.example
!.env.production.example

# --- TLS certificates & private keys ---
certs/
*.key
*.pem
*.p12

# --- Runtime & process state ---
.valence-api.pid
*.db
valence.db

# --- Python artifacts ---
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
env/
venv/

# --- Build artifacts ---
build/
dist/
*.egg-info/

# --- Demo media & recording (ADR-0008: never commit) ---
*.mp4
*.mov
*.webm
*.avi
*.mkv
*demo*.log
demo_record.log
advance_demo_record.log
.demo_video_tmp/
.advance_demo_tmp/

# --- Internal planning & scratch docs (ADR-0008) ---
docs/PRODUCT_ROADMAP.md
docs/LAUNCH_READINESS.md
docs/project_playbook.*
annotated_file_structure.md
research_synthesis_report.md
ADR.md

# --- AI-generated / presentation artifacts (ADR-0008) ---
VALENCE_ENTERPRISE_BLUEPRINT*.md
VALENCE_ENTERPRISE_CISO_PLAYBOOK*
VALENCE_CISO_Presentation*.html
VALENCE_INTERACTIVE_PRESENTATION*.html
VALENCE_GRAPHICAL_PRESENTATION_DECK*.md
generate_playbook.py

# --- Development screenshots & AI-generated diagrams ---
Risk_Simulator_Curve*.png
architecture_diagram_*.png
dashboard_mockup_*.png
evidence_chain_*.png
dashboard-threat-layout.png
landing-*-refresh.png
playwright-*.png

# --- Orphaned scratch files ---
test_policy.py

# --- Generated output ---
output/*
!output/.gitkeep
data/cache/*
data/demo_credentials.json

# --- Coverage ---
.coverage
htmlcov/

# --- OS & editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
